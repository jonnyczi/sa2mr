# CMake cross toolchain: x86_64 host -> aarch64 Linux, clang + lld against the sysroot in
# $SYSROOT (Valve's sniper arm64 SDK: glibc 2.31, libstdc++ 10). Used by build.sh --cross.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT "$ENV{SYSROOT}")
set(CMAKE_C_COMPILER "$ENV{CROSS_CC}")
set(CMAKE_CXX_COMPILER "$ENV{CROSS_CXX}")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_AR "$ENV{CROSS_AR}" CACHE FILEPATH "")
set(CMAKE_RANLIB "$ENV{CROSS_RANLIB}" CACHE FILEPATH "")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH "$ENV{DEPS}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
