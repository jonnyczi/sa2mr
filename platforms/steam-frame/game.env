# Sonic Adventure 2 VR on the Steam Frame: the game's settings (installed as share/game.env.vr;
# sa2mr-vr.sh makes share/game.env from it and ~/.config/sa2mr/game.env.local, whose lines
# replace these by name).
#
# The first block is what tools/s7/release_build.py writes for every release: play_live's boot
# session's settings (reach ENV, the default profile, no bound) with the recorder's sound.
SA2_D3D9_DEVICE=1
SA2_DSOUND_DEVICE=1
SA2_IMPORT_BUDGET=0
SA2_PUMP_POLLS=0
SA2_DINPUT_DEVICE=1
SA2_XAUDIO2_DEVICE=1
SA2_DDRAW_DEVICE=1
SA2_D3DX_CONSTANT_TABLE=1
SA2_VIRTUAL_BUDGET_MS=0
SA2_REC_AUDIO=1
# The VR player's: the game records its camera (a version 3 stream) and the draw marks (the Chao
# status bubble, version 4), as host/xr/build.sh adds them to the VR release's game.env.
SA2_REC_CAMERA=1
SA2_REC_DRAWMARK=1
# Tweaks (runtime/sa2_tweaks.h): host/xr/build.sh's VR set (the level and Chao World drawn all
# around, the hands in the garden, Sonic out of the window) with the Frame's own: no intro, and the
# wider gameplay camera the Frame was tested with. Not here: practice-stage (a test start that
# saves nothing) and draw-distance (the user's decision of 2026-11-22: normal draw distance).
SA2_TWEAKS=skip-intro,fov,vr-level-culling,vr-object-culling,vr-chao-hands,vr-sonic
SA2_FOV_SCALE=1.4
# Room Run: letting go of Sonic in the room puts him on the generated course.
SA2_VR_ROOM_RUN=1
