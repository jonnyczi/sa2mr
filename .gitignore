# external/: local clones and toolchains stay out, except the OpenSA2 fork, a submodule
# (github.com/jonnyczi/OpenSA2, branch sa2mr; its own .gitignore keeps private/ out).
/external/*
!/external/OpenSA2

# Screenshots and eye dumps show SEGA's game content, and are large: keep them local.
/media/

# Build outputs, toolchains, logs
/build-env/logs/
/build-env/arm64/sysroot/
/build-env/arm64/s5-tools/
/build-env/arm64/test/home/
/roomrun/build/

# Local Claude settings
/.claude/settings.local.json

# Python bytecode
__pycache__/
