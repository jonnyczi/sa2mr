From c0be895992509c7ab783844c559f36a8c822adfd Mon Sep 17 00:00:00 2001
From: jonnyczi <czijonny@gmail.com>
Date: Sat, 21 Nov 2026 12:12:15 +0800
Subject: [PATCH] Guard the x86 FPU code in shaderc and dxvk_smoke for AArch64
 builds

d3d9gpu_shaderc included <xmmintrin.h> and set MXCSR for --ftz-daz, and
dxvk_smoke read the x87 control word, unconditionally, so neither
host/d3d9gpu/build.sh nor host/player/build.sh compiled for aarch64 Linux.
Both now use the guards d9g_shader.cpp and d9g_report.cpp already use.
On AArch64, --ftz-daz sets FPCR.FZ, which flushes denormal inputs and
outputs as FTZ and DAZ do together, and dxvk_smoke reports a control word
of 0. The x86 builds compile the same code as before.
---
 host/d3d9gpu/test/shaderc.cpp | 9 +++++++++
 host/dxvk_smoke.cpp           | 8 +++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/host/d3d9gpu/test/shaderc.cpp b/host/d3d9gpu/test/shaderc.cpp
index f712ed7..5577bac 100644
--- a/host/d3d9gpu/test/shaderc.cpp
+++ b/host/d3d9gpu/test/shaderc.cpp
@@ -76,7 +76,9 @@
 #include <dlfcn.h>
 #endif
 #include <sys/stat.h>
+#if defined(__x86_64__) || defined(__i386__)
 #include <xmmintrin.h>
+#endif
 
 #include <algorithm>
 #include <cmath>
@@ -1408,7 +1410,14 @@ int main(int argc, char** argv) {
       else if (!strcmp(argv[i], "--repo") && i + 1 < argc) repo = argv[++i];
       else if (!strcmp(argv[i], "--verify")) verify = true;
       else if (!strcmp(argv[i], "--force-sample-rate-shading")) {}  // read above, into the profile
+#if defined(__x86_64__) || defined(__i386__)
       else if (!strcmp(argv[i], "--ftz-daz")) _mm_setcsr(_mm_getcsr() | 0x8040u);  // FTZ | DAZ
+#elif defined(__aarch64__)
+      else if (!strcmp(argv[i], "--ftz-daz")) {  // FPCR.FZ (bit 24) flushes denormal inputs and outputs: FTZ | DAZ
+        uint64_t fpcr; __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+        __asm__ volatile("msr fpcr, %0" : : "r"(fpcr | (1u << 24)));
+      }
+#endif
       else { fprintf(stderr, "unknown option %s\n", argv[i]); return 2; }
     }
     std::unique_ptr<Cache> cache;
diff --git a/host/dxvk_smoke.cpp b/host/dxvk_smoke.cpp
index f20407c..7877b20 100644
--- a/host/dxvk_smoke.cpp
+++ b/host/dxvk_smoke.cpp
@@ -12,7 +12,13 @@
 
 using PFN_Direct3DCreate9 = IDirect3D9* (*)(UINT);
 
-static uint16_t x87_cw() { uint16_t cw; __asm__ __volatile__("fnstcw %0" : "=m"(cw)); return cw; }
+static uint16_t x87_cw() {  // 0 where there is no x87
+    uint16_t cw = 0;
+#if defined(__x86_64__) || defined(__i386__)
+    __asm__ __volatile__("fnstcw %0" : "=m"(cw));
+#endif
+    return cw;
+}
 
 static int fail(const char* what, HRESULT hr = 0) {
   std::fprintf(stderr, "FAIL: %s (hr=0x%08x)\n", what, unsigned(hr));
-- 
