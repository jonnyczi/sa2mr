From 6db4f3c058df46c6f5083c77cb35f701b645bd00 Mon Sep 17 00:00:00 2001
From: jonnyczi <czijonny@gmail.com>
Date: Sat, 21 Nov 2026 12:30:10 +0800
Subject: [PATCH] State the fresh-clone build prerequisites the getting-started
 guide left out

Following docs/getting-started.md from a fresh clone stopped at four places:

- s1_function_map.py reads the SA2 Mod Loader's SA2Functions.h from the path
  tools/pins.json pins, which nothing told a reader to check out; without it
  the script stopped with a FileNotFoundError. The guide now gives the clone
  and the pinned commit, and the script names them when the header is missing.
- Nothing said where Ghidra, the Temurin JDK and Zig are unpacked; the guide
  now points at their pinned paths.
- build_host_deps.sh --fetch never downloads the ALSA headers package; the
  guide now says to stage it from its pinned URL first.
- release_build.py links the double f80 build by default, and the guide went
  from the link tables to the desktop build without the perf_f80.py step that
  makes it.

The s1 receipt is written to Documentation/receipts/ with the analyzeHeadless
command and the environment as they ran, which hold the checkout's absolute
path. The receipt now records them relative to the checkout; run.json under
private/ghidra keeps them as they ran.
---
 Documentation/scripts/s1_function_map.py | 10 ++++++++--
 docs/getting-started.md                  | 22 ++++++++++++++++++----
 2 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/Documentation/scripts/s1_function_map.py b/Documentation/scripts/s1_function_map.py
index 02b6045..5f23b0a 100644
--- a/Documentation/scripts/s1_function_map.py
+++ b/Documentation/scripts/s1_function_map.py
@@ -250,6 +250,10 @@ def string_clusters(image: Image) -> dict:
 
 
 def modloader_functions(root: Path) -> tuple[dict[int, str], dict[str, int]]:
+    if not (root / HEADER).is_file():
+        pin = json.loads((root / PINS).read_text())["tools"]["sa2-mod-loader"]
+        sys.exit(f"{HEADER} is missing: check out https://github.com/X-Hax/sa2-mod-loader at "
+                 f"{pin['commit']} into {pin['path']} (tools/pins.json sa2-mod-loader)")
     text = (root / HEADER).read_text(encoding="utf-8", errors="replace")
     names: dict[int, str] = {}
     by_macro: dict[str, int] = {}
@@ -679,10 +683,12 @@ def main() -> int:
             "modloader_header_sha256": sha256(root / HEADER),
             "ghidra_analysis": "default auto-analysis options of analyzeHeadless -import",
         },
+        # The receipt is in the tracked tree, so the checkout's paths in it are relative to
+        # the checkout: run.json keeps them as they ran.
         "command": {
             "driver": ".venv/bin/python Documentation/scripts/s1_function_map.py",
-            "analyzeHeadless": run["command"],
-            "env": run["env"],
+            "analyzeHeadless": run["command"].replace(f"{root}/", ""),
+            "env": {k: v.replace(f"{root}/", "") for k, v in run["env"].items()},
         },
         "outputs": outputs,
         "artifacts": {
diff --git a/docs/getting-started.md b/docs/getting-started.md
index 28238bd..27d3151 100644
--- a/docs/getting-started.md
+++ b/docs/getting-started.md
@@ -113,16 +113,19 @@ Before running a full build, prepare these inputs:
 - The supported installation's file-verification table.
 - For Android, the SDK, NDK, and Java tools expected by the Android builder.
 
-`tools/env.sh` names the expected local layout. It adds existing tools to `PATH`; it does not install them or generate the game image. Consult each script's module documentation and `--help` where available before using it.
+`tools/env.sh` names the expected local layout. It adds existing tools to `PATH`; it does not install them or generate the game image. Unpack the pinned Ghidra, Temurin JDK, and Zig releases so that their folders are the `path` of `ghidra`, `java`, and `zig` in `tools/pins.json`. Consult each script's module documentation and `--help` where available before using it.
+
+`tools/s5/build_host_deps.sh --fetch` downloads the pinned source archives, but never the ALSA development headers package. Download the file that `sdl3.alsa_headers.url` in `tools/pins.json` names into `private/s5-tools/dl/` first; the script checks it against the pin.
 
