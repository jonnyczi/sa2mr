+def test_a_rebuild_finishes_a_restored_extras_state(rebuild, monkeypatch, tmp_path, capsys):
+    """track_extra_functions.py --restore writes rows only; the link steps read `objects`
+    and `registry_c`, which lift_extra.py's main writes and the rebuild now writes too."""
+    obj = tmp_path / "extras" / "ir_00500000.o"
+    obj.parent.mkdir()
+    RI.STATE.write_text(json.dumps({"tag": "next+allarms", "lift_tag": "next", "arms_tag": "next",
+                                    "rows": [{"va": "0x00500000", "end": "0x00500010",
+                                              "object": str(obj), "compiled": True,
+                                              "declares_sub": []}]}))
+
+    def rebuilt(r):
+        write(obj, b"NEW")
+        return {"va": r["va"], "compiled": True, "same_path": True}
+    monkeypatch.setattr(RI, "_extra", rebuilt)
+    assert RI.main() == 0
+    state = json.loads(RI.STATE.read_text())
+    assert state["objects"] == [str(obj)] and state["registered"] == 1 and state["rejected"] == 0
+    assert state["registry_c"] == str(tmp_path / "extra_functions.next+allarms.c")
+    assert "sub_500000" in Path(state["registry_c"]).read_text()
+    out = json.loads(capsys.readouterr().out)
+    assert out["extras_registered"] == 1 and out["extras_rejected"] == 0
+
+
 def test_a_rebuild_that_stops_part_way_leaves_no_stamp(rebuild):
