     return out
 
 
+def finalize(state: dict, state_path: Path, tag: str, lift_tag: str,
+             arms_tag: str | None) -> list[dict]:
+    """Reject the rows that cannot link, write the registry beside `state_path`, record the
+    objects the link reads in `state`, and write it there. Returns the registered rows.
+
+    `main` ends with this, and `tools/s4/rebuild_image.py` runs it after rebuilding the
+    extras: a state restored from the tracked record (`track_extra_functions.py --restore`)
+    has rows and no `objects` or `registry_c`, which the link steps read."""
+    # A module may declare `sub_X` for a call target that nothing defines -- a
+    # garbage lift, or a target that is itself in no module. Linking it fails
+    # with an undefined symbol thousands of objects later, so the rejection
+    # happens here, with a reason, and iterates: rejecting one module can orphan
+    # the next.
+    defined = {f"sub_{va:x}" for va, _e, _n in module_ranges(lift_tag, arms_tag)}
+    rejected = []
+    while True:
+        avail = defined | {f"sub_{int(r['va'], 16):x}" for r in state["rows"]
+                           if r.get("compiled") and not r.get("rejected")}
+        changed = False
+        for r in state["rows"]:
+            if not r.get("compiled") or r.get("rejected"):
+                continue
+            missing = [d for d in r.get("declares_sub", []) if d not in avail]
+            if missing:
+                r["rejected"] = True
+                r["rejected_why"] = ("declares " + ", ".join(missing[:4])
+                                     + ", which no module in this build defines")
+                rejected.append(r["va"])
+                changed = True
+        if not changed:
+            break
+    state["rejected"] = len(rejected)
+    state["rejected_head"] = rejected[:20]
+    good = [r for r in state["rows"] if r.get("compiled") and not r.get("rejected")]
+    registry = state_path.parent / f"extra_functions.{tag}.c"
+    emit_registry(good, registry, tag)
+    state.update(tag=tag, lift_tag=lift_tag, arms_tag=arms_tag,
+                 registered=len(good), attempted=len(state["rows"]),
+                 objects=[r["object"] for r in good],
+                 registry_c=str(registry))
+    state_path.write_text(json.dumps(state, indent=1) + "\n")
+    return good
+
+
 def main() -> None:
     ap = argparse.ArgumentParser()
     ap.add_argument("--tag", required=True)
