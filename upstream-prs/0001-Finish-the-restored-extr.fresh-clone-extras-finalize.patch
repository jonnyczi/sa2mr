+    assert written["objects"] == [r["object"] for r in written["rows"]]
+    assert written["registered"] == 2 and written["attempted"] == 2 and written["rejected"] == 0
+    registry = Path(written["registry_c"])
+    assert registry == record.parent / "extra_functions.next+allarms.c"
+    text = registry.read_text()
+    assert "(sa2_lifted_fn)sub_401000," in text and "(sa2_lifted_fn)sub_436410," in text
+    # Nothing was rejected, so the state still projects to the tracked record.
+    assert T.project("next+allarms") == json.loads(T.OUT.read_text())
+
+
+def test_finalize_rejects_a_row_whose_callee_no_module_defines(record):
+    rows = [{**ROWS[0], "declares_sub": ["sub_436400"]},
+            {**ROWS[1], "declares_sub": ["sub_500000"]},
+            {**ROWS[0], "va": "0x00402000", "declares_sub": ["sub_436410"]}]
+    state = {"rows": [{**r, "object": f"/obj/{r['va']}.o"} for r in rows]}
+    good = LE.finalize(state, record, "next+allarms", "next", "next")
+    # The second declares a callee nothing defines; the third calls the second, so it goes too.
+    assert [r["va"] for r in good] == ["0x00401000"]
+    written = json.loads(record.read_text())
+    assert written["objects"] == ["/obj/0x00401000.o"]
+    assert written["rejected"] == 2 and written["rejected_head"] == ["0x00436410", "0x00402000"]
+    assert "sub_500000" in written["rows"][1]["rejected_why"]
+    assert "sub_436410" not in Path(written["registry_c"]).read_text()
